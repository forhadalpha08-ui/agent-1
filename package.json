    "firebase": "^12.19.0",
    "lucide-react": "^0.468.0",
    "motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^19.3.0",
    "react-markdown": "^9.0.1",
    "recharts": "^3.10.1",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
